ue);\n mat.setColor(\"Specular\",ColorRGBA.White);\n mat.setColor(\"Diffuse\",ColorRGBA.White);\n mat_lit.setFloat(\"Shininess\", 5f); // 1-128\n shiny_rock.setMaterial(mat_lit);\n rootNode.attachChild(shiny_rock);\n "; return body; }
