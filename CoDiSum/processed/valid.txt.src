gators // public static <K, V> Aggregator<BigDecimal, K, V> bigDecimalAvg() { return new BigDecimalAverageAggregator<K, V>(); @@ -289,5 +289,4 @@ public final class Aggregators { public static <K, V> Aggregator<Double, K, V> floatingPointSum(String attributePath) { return new FloatingPointSumAggregator<K, V>(attributePath); } - }
